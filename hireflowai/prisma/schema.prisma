// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String       @id @default(cuid())
  name     String?
  email    String       @unique
  password String?
  role     UserTypeEnum @default(ADMIN)

  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  companyId     String?
  hrStatus      HrStatus  @default(ENABLE)
  company       Company?  @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, role, hrStatus])
  @@map("users")
}

//Auth.js prismaAdapter required models - used only for dashboard users
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// this is company/saas Tencancy 
model Company {
  id          String   @id @default(cuid())
  companyName String //name of the company 
  email       String   @unique // email of the company
  address     String? // address of the company
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---NEW :Settings-Page fields ---
  applicationCooldownDays Int           @default(30)
  rejectionThreshold      Int           @default(40)
  recommendedThreshold    Int           @default(75)
  aiDefaultPrompt         String?
  users                   User[]
  widgets                 Widget[]
  candidates              Candidate[]
  interviews              Interview[]
  applications            Application[]
  jobs                    Job[]
}

model Widget {
  id             String        @id @default(cuid())
  //Public identifier used in the embed script
  widgetId       String        @unique @default(cuid())
  widgetName     String?
  // company that owns this widget 
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  //Security checks
  allowedDomains String[]
  isActive       Boolean       @default(true)
  //this is the metadata
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]

  @@index([companyId])
}

// this is the candidate model 
model Candidate {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String?
  email         String?
  phone         String?
  googleSub     String?
  emailVerified DateTime?
  image         String?
  accounts      CandidateAccount[]
  sessions      CandidateSession[]
  applications  Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews Interview[]

  @@unique([companyId, email]) // ← lives here, where email actually is
  @@unique([companyId, phone])
  @@unique([companyId, googleSub])
  @@index([companyId])
}

model CandidateAccount {
  id                String  @id @default(cuid())
  candidateId       String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model CandidateSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  candidateId  String
  expires      DateTime

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidateVerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Application {
  id String @id @default(cuid())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  widgetId        String
  widget          Widget              @relation(fields: [widgetId], references: [id], onDelete: Restrict)
  jobId           String
  job             Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  resumeUrl       String?
  resumePublicUrl String?
  candidateStatus CandidateStatusEnum @default(UNEVALUATED)

  interviews   Interview[]
  aiEvaluation AIEvaluation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([candidateId])
  @@index([widgetId])
  @@index([jobId])
}

model AIEvaluation {
  id              String           @id @default(cuid())
  applicationId   String           @unique // ← one evaluation per application, not per candidate
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  aiScore         Int
  skillsMatch     Int
  experienceMatch Int
  educationMatch  Int
  projectMatch    Int
  jobRelevance    Int
  matchedSkills   String[]
  missingSkills   String[]
  reason          String
  recommendation  AIRecommendation
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Interview {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewLink   String?
  interviewTime   DateTime? //time for the interview
  //this is the status of the interview
  interViewStatus InterStatusEnum
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  application     Application?    @relation(fields: [applicationId], references: [id])
  applicationId   String?

  @@index([companyId])
  @@index([candidateId])
}

model Job {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title            String
  description      String
  isActive         Boolean  @default(true)
  // ── NEW ──
  evaluationPrompt String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications Application[]

  @@index([companyId])
}

enum CandidateStatusEnum {
  REJECTED
  RECOMMENDED
  INTERVIEWING
  OFFERED
  ON_TRIAL
  PLACED
  WITHDRAW
  UNEVALUATED
}

enum InterStatusEnum {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum UserTypeEnum {
  SUPERUSER
  ADMIN
  HR
}

enum AIRecommendation {
  RECOMMEND
  REVIEW
  REJECT
}

enum HrStatus {
  ENABLE
  DISABLE
}
