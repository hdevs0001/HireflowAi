// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id       String       @id @default(cuid())
  name     String?
  email    String       @unique
  password String?
  role     UserTypeEnum @default(ADMIN)

  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  companyId     String?
  hrStatus      HrStatus  @default(ENABLE)
  company       Company?  @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, role, hrStatus])
  @@map("users")
}

model Company {
  id          String      @id @default(cuid())
  companyName String //name of the company 
  email       String      @unique // email of the company
  address     String? // address of the company
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  users       User[]
  widgets     Widget[]
  candidates  Candidate[]
  interviews  Interview[]
}

model Widget {
  id             String   @id @default(cuid())
  //Public identifier used in the embed script
  widgetId       String   @unique @default(cuid())
  // company that owns this widget 
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  //Security checks
  allowedDomains String[]
  isActive       Boolean  @default(true)
  //this is the metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
}

model Candidate {
  id              String              @id @default(cuid())
  companyId       String // attach to every apply request
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String
  resumeUrl       String
  resumePublicUrl String
  candidateStatus CandidateStatusEnum @default(PROCESSING)

  interviews   Interview[]
  AIEvaluation AIEvaluation?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyId, email])
  @@unique([companyId, phone])
  @@index([companyId])
}

model AIEvaluation {
  id              String           @id @default(cuid())
  candidateId     String           @unique
  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  aiScore         Int
  skillsMatch     Int
  experienceMatch Int
  educationMatch  Int
  projectMatch    Int
  jobRelevance    Int
  matchedSkills   String[]
  missingSkills   String[]
  reason          String
  recommendation  AIRecommendation
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Interview {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewLink   String?
  interviewTime   DateTime? //time for the interview
  //this is the status of the interview
  interViewStatus InterStatusEnum
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([companyId])
  @@index([candidateId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum CandidateStatusEnum {
  PROCESSING
  ACCEPTED
  REJECTED
  INTERVIEWING
  PLACED
}

enum InterStatusEnum {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum UserTypeEnum {
  SUPERUSER
  ADMIN
  HR
}

enum AIRecommendation {
  RECOMMEND
  REVIEW
  REJECT
}

enum HrStatus {
  ENABLE
  DISABLE
}
